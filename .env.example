# Otari (https://otari.ai), the gateway every model call goes through. A service key, so each restaurant can be
# an end user with its own budget (see docs/OTARI_SETUP.md). EU accounts: https://eu.api.otari.ai/api/v1,
# US accounts: https://api.otari.ai/api/v1
OTARI_API_KEY=
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
# Model names the app asks Otari for (defaults: the routing policies in docs/OTARI_SETUP.md)
# OTARI_RESEARCH_MODEL=tablecast-research
# OTARI_WRITE_MODEL=tablecast-write
# OTARI_ECONOMY_MODEL=tablecast-economy
# OTARI_CHECK_MODEL=tablecast-check
# OTARI_QUARTERMASTER_MODEL=tablecast-quartermaster
# OTARI_VISION_MODEL=alibaba/qwen3-vl-235b-a22b-instruct
# Local development cap on top of Otari's budgets (ledger at ~/data/otari/usage.jsonl outside Vercel; "off" disables)
# OTARI_LOCAL_CAP_USD=6
# OTARI_LOCAL_LEDGER=

# Live web research (https://tavily.com, free tier works)
TAVILY_API_KEY=

# Optional: events near the restaurant (https://developer.ticketmaster.com, free key)
TICKETMASTER_API_KEY=

# Optional public-demo limits
LIVE_RUNS_PER_IP_PER_HOUR=4
LIVE_RUNS_DAILY_CAP=80
LIVE_RUNS_MAX_CONCURRENT=3

# Optional: the judges' link, https://<deployment>/?judge=<JUDGE_LINK_TOKEN> (docs/OTARI_SETUP.md, section 7).
# Every request of a judge run is billed to one Otari end user on its own budget.
# JUDGE_LINK_TOKEN=
# JUDGE_BUDGET_ID=
# JUDGE_END_USER=judges:mozfest-wilding-2026
# JUDGE_LINK_EXPIRES=2026-12-31T23:59:59Z
# JUDGE_SPEND_CAP_USD=
# JUDGE_RUNS_PER_HOUR=3
# JUDGE_RUNS_PER_DAY=6
