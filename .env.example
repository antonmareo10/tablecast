# NVIDIA Nemotron on Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model routing (defaults shown)
NEBIUS_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_ECONOMY_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_REASONING_EFFORT=medium

# Live web research (https://tavily.com, free tier works)
TAVILY_API_KEY=

# Optional: events near the restaurant (https://developer.ticketmaster.com, free key)
TICKETMASTER_API_KEY=

# Optional public-demo limits
LIVE_RUNS_PER_IP_PER_HOUR=4
LIVE_RUNS_DAILY_CAP=80
LIVE_RUNS_MAX_CONCURRENT=3

# --- Buffer Commit work (branch buffer) ---
# App client from https://publish.buffer.com/settings/api (App Clients). Paste with pegar-clave.ps1, never in chat.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Exact redirect URI registered with Buffer. Local: https://localhost:3000/api/buffer/callback (run: next dev --experimental-https)
BUFFER_REDIRECT_URI=
# 32+ characters, seals the OAuth and session cookies: openssl rand -hex 32
SESSION_SECRET=
# Optional: separate secret for image URLs (defaults to SESSION_SECRET). Changing it breaks URLs of queued posts.
IMAGE_SIGNING_SECRET=
# Public https origin Buffer downloads images from (defaults to the request host)
PUBLIC_ORIGIN=
